<resources>

    <!--
        Modern application theme (2026 redesign):
        - DayNight base so light/dark follow the system with one palette
        - Indigo primary + teal accent, soft neutral surfaces
        - Ripple-based touch feedback, rounded corners on dialogs/menus
        - Toolbar and status bar tinted with the primary color in light
          and a deep indigo surface in dark for comfortable contrast
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="backgroundColor">@color/background</item>
        <item name="colorControlNormal">@color/colorTextSecondary</item>
        <item name="colorControlActivated">@color/colorPrimary</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <item name="android:textColorHint">@color/colorTextSecondary</item>
        <item name="drawerArrowStyle">@style/DrawerArrowStyle</item>
    </style>

    <style name="DrawerArrowStyle" parent="@style/Widget.AppCompat.DrawerArrowToggle">
        <item name="spinBars">true</item>
        <item name="color">@color/colorWhite</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.NoActionBar.SplashScreen" parent="AppTheme.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="ToolbarColoredBackArrow" parent="AppTheme">
        <item name="android:textColorSecondary">@color/colorWhite</item>
        <item name="android:editTextColor">@color/colorWhite</item>
        <item name="android:textColorHint">@color/colorWhiteTransparent</item>
    </style>

    <style name="Toolbar.TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/colorWhite</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.DayNight" />

    <style name="AppTheme.Button">
        <item name="android:textColor">@color/colorWhite</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:backgroundTint">@color/colorPrimary</item>
    </style>

    <style name="label" parent="Theme.AppCompat.DayNight">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppTheme.DayNight" parent="Theme.AppCompat.DayNight">
    </style>

    <style name="AppTheme.BottomSheetDialog">
        <item name="android:textSize">15sp</item>
        <item name="colorControlNormal">@color/colorTextPrimary</item>
    </style>

    <style name="AppTheme.Setting">
        <item name="android:textSize">17sp</item>
    </style>

    <style name="AppTheme.Setting.Item">
        <item name="android:paddingLeft">5dp</item>
        <item name="android:paddingRight">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:paddingTop">5dp</item>
    </style>

    <style name="AppTheme.Setting.Line">
        <item name="android:background">@color/lineColor</item>
    </style>

    <style name="AppTheme.Setting.SubText">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
    </style>

    <style name="AppTheme.Link">
        <item name="android:textColor">@color/colorLink</item>
    </style>

    <style name="AppTheme.Heading">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <style name="AppTheme.SubHeading">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextSubPrimary</item>
    </style>

    <!-- Modern card surface used for server rows and info blocks -->
    <style name="AppTheme.Card">
        <item name="android:background">@color/colorSurface</item>
    </style>
</resources>
